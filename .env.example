# djai settings. Every variable is OPTIONAL -- the value shown is the built-in
# default from djai/config.py. Copy this file to `.env` and edit, or just export
# the ones you want; the program reads the process environment directly and does
# not load .env itself.
#
# There are no API keys or secrets here. Inference is local.

# --- Ollama (local inference) -------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=8.0
OLLAMA_WARMUP_TIMEOUT_S=60.0

# --- Audio output -------------------------------------------------------------
AUDIO_BLOCKSIZE=2048
CUE_RING_BLOCKS=8
ECHO_MAX_SECONDS=2.0
FILTER_KNOB_RESONANCE=0.3

# --- Loudness and limiting ----------------------------------------------------
LOUDNESS_TARGET_LUFS=-14.0
LOUDNESS_MAX_TRUE_PEAK_DBTP=-1.0
LIMITER_KNEE=0.90
LIMITER_RELEASE_MS=150.0
LIMITER_SUBBLOCK=64
LIMITER_LOG_REDUCTION_DB=1.0

# --- Time stretch / key lock --------------------------------------------------
TIME_STRETCH_ENABLED=1
KEY_LOCK_DEFAULT=1
MAX_STRETCH_RATIO=0.08
STRETCH_CACHE_SIZE=2
STRETCH_DEADBAND=0.002

# --- Analysis -----------------------------------------------------------------
TEMPO_AMBIGUITY_RATIO=0.85

# --- Transitions --------------------------------------------------------------
TRANSITION_BARS=24.0
TRANSITION_DESIGN_WAIT_S=12.0

# --- Tempo journey / closed loop ----------------------------------------------
FEATURE_BUS_CAPACITY=512
MASTER_GLIDE_BARS=16
MASTER_TEMPO_LOCKED=0
CLOSED_LOOP_ENABLED=1
ROOM_MIC_ENABLED=0

# --- Offline preview / audition ----------------------------------------------
PREVIEW_ENABLED=1
PREVIEW_BUDGET_MS=4000.0
PREVIEW_MS_PER_AUDIO_S=40.0
PREVIEW_PRE_ROLL_S=30.0
PREVIEW_CONTEXT_BARS=4.0
PREVIEW_COMMIT_MARGIN_S=1.0
PREVIEW_MAX_ROUNDS=2
PREVIEW_LLM_REVISION=1
PREVIEW_LLM_TIMEOUT_S=2.0
PREVIEW_MAX_PEAK_DBFS=-1.0
PREVIEW_MAX_LOUDNESS_DIP_DB=3.0
PREVIEW_MAX_LOW_OVERLAP_BARS=2.0
PREVIEW_MAX_SPECTRAL_CLASH=0.6
PREVIEW_MIN_PHASE_COHERENCE=0.5
PREVIEW_BAND_PRESENT_FRAC=0.18

# --- Recording ----------------------------------------------------------------
RECORD_ENABLED=0
RECORD_DIR=recordings
RECORD_RETENTION=5
RECORD_RING_SECONDS=8.0

# --- Watchdog / fallback ------------------------------------------------------
FALLBACK_ENABLED=1
FALLBACK_STALL_MS=400.0
FALLBACK_UNDERRUN_BURST=8
FALLBACK_WATCHDOG_HZ=20.0

# --- Preflight ----------------------------------------------------------------
PREFLIGHT_MIN_DISK_MB=3000
PREFLIGHT_MAX_DECODE_CHECKS=0
